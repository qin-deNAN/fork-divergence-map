# 复制本文件为 .env，填入自己的值。.env 不要提交到代码仓库。

# 可选：zhihu-cli 路径。不填也会自动探测官方默认安装位置。
# ZHIHU_CLI_BIN=C:\path\to\zhihu-cli.exe

# 可选：无图形界面时直接注入凭证。推荐用 CLI 的 auth set --secret-stdin，这里留空即可。
# ZHIHU_ACCESS_SECRET=

# 必填：模型服务，任何 OpenAI 兼容端点都可以
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=在这里填你的密钥
LLM_MODEL=deepseek-chat

# 可选：设为 sample 可强制使用示例数据，方便未配置凭证时演示
# FORK_DATA_SOURCE=sample

# 可选：本地端口
PORT=4173
